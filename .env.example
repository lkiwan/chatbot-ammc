# ── LLM (Groq ou tout provider compatible OpenAI) ──────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.atria-asi.ai/v1
GROQ_MODEL=Atria-Dawn-Preview

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ammc_finance
POSTGRES_USER=ammc
POSTGRES_PASSWORD=ammc_secret
DATABASE_URL=postgresql+psycopg2://ammc:ammc_secret@localhost:5432/ammc_finance

# ── RAG ────────────────────────────────────────────────────────────────────
# Nombre de chunks retournés par ChromaDB
TOP_K=10
HISTORY_LIMIT=8

# ── Extraction ─────────────────────────────────────────────────────────────
# Score de confiance minimum pour stocker une métrique
EXTRACTION_CONFIDENCE_THRESHOLD=0.4
# Activer le mode verbose pour les logs d'extraction
EXTRACTION_DEBUG=false

# ── Serveur / production ───────────────────────────────────────────────────
# Origins autorisés à appeler l'API (séparés par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Indexation automatique des nouveaux PDF (false en production)
WATCH_ENABLED=true
# URL de l'API pour le frontend déployé sur Vercel (ex: https://api.exemple.com)
VITE_API_BASE=
